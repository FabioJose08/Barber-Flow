<%- include('../partials/header') %>

<div class="auth-container">
  <div class="card card-premium auth-card">
    <div class="auth-logo" style="text-align: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 2rem; letter-spacing: 0.05em; color: var(--text-main);">Área do Cliente</h2>
      <p style="color: var(--text-muted); margin-top: 0.4rem;">Faça login para agendar e consultar seus horários.</p>
    </div>

    <% if (locals.error) { %>
      <div class="alert alert-danger" style="margin-bottom: 1rem;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <button type="button" class="btn-google" data-google-signin="/client/auth/google" id="google-signin-client">
      <svg class="google-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      Entrar com Google
    </button>

    <p style="margin: 1.25rem 0; color: var(--text-muted); font-size: 0.8rem;">ou entre com e-mail</p>

    <form action="/client/login" method="POST" style="width: 100%;">
      <div class="form-group">
        <label class="form-label" for="email">
          <i class="fa-solid fa-envelope" style="margin-right: 0.4rem;"></i>E-mail
        </label>
        <input type="email" class="form-control" id="email" name="email" placeholder="seu@email.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">
          <i class="fa-solid fa-lock" style="margin-right: 0.4rem;"></i>Senha
        </label>
        <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.9rem;">
        <i class="fa-solid fa-right-to-bracket"></i> Entrar
      </button>
    </form>

    <div class="auth-footer">
      <a href="/client/register" style="font-size: 0.9rem;">Não tem conta? Cadastre-se</a>
      <br>
      <a href="/login" style="display: inline-block; margin-top: 0.75rem; font-size: 0.8rem; color: var(--gold-primary);">Área do Barbeiro</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
