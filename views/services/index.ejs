<%- include('../partials/header') %>

<div class="page-header">
  <div class="page-title">
    <h1>Serviços & Configurações</h1>
    <p>Gerencie o catálogo de serviços e defina as configurações da sua barbearia para o agendamento dos clientes.</p>
  </div>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success animate-fade-in" style="margin-bottom: 2rem;">
    <i class="fa-solid fa-circle-check"></i>
    <span>
      <% if (success === '1') { %>
        Serviço adicionado com sucesso!
      <% } else if (success === '2') { %>
        Serviço removido com sucesso!
      <% } else if (success === 'config') { %>
        Configurações da barbearia atualizadas com sucesso!
      <% } %>
    </span>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger animate-fade-in" style="margin-bottom: 2rem;">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span><%= error %></span>
  </div>
<% } %>

<!-- Sidebar style page layout: Left side (Services), Right side (Shop Configurations) -->
<div class="dashboard-layout" style="align-items: flex-start; gap: 2rem;">
  
  <!-- Left Side: Catalog of Services -->
  <div class="card card-premium" style="flex: 1 1 55%;">
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-tags"></i> Catálogo de Serviços</h3>
    </div>
    
    <!-- Add Service Form -->
    <form action="/services" method="POST" style="margin-bottom: 2rem; background: var(--bg-tertiary); padding: 1.25rem; border-radius: 8px; border: 1px solid var(--border-color);">
      <h4 style="margin-bottom: 1rem; color: var(--gold-primary); font-family: 'Cinzel';"><i class="fa-solid fa-plus"></i> Novo Serviço</h4>
      <div class="service-form-grid" style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1rem; align-items: flex-end;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="name" class="form-label">Nome do Serviço *</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Ex: Corte Navalhado" required autocomplete="off">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="price" class="form-label">Preço *</label>
          <div class="input-prefix-wrapper">
            <span class="input-prefix">R$</span>
            <input type="number" id="price" name="price" class="form-control" placeholder="0,00" step="0.01" min="0" required>
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="duration_min" class="form-label">Duração *</label>
          <select id="duration_min" name="duration_min" class="form-control" required>
            <option value="15">15 min</option>
            <option value="30" selected>30 min</option>
            <option value="45">45 min</option>
            <option value="60">60 min</option>
            <option value="90">90 min</option>
            <option value="120">120 min</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary" style="margin-top: 1rem; width: 100%;">
        <i class="fa-solid fa-circle-plus"></i> Adicionar ao Catálogo
      </button>
    </form>

    <!-- Services Table List -->
    <% if (services.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-scissors"></i>
        <h3>Sem serviços cadastrados</h3>
        <p>Adicione serviços acima para que os clientes possam agendá-los.</p>
      </div>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table class="financial-table" style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
              <th style="padding: 0.75rem;">Serviço</th>
              <th style="padding: 0.75rem;">Preço</th>
              <th style="padding: 0.75rem;">Duração</th>
              <th style="padding: 0.75rem; text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% services.forEach(svc => { %>
              <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;">
                <td style="padding: 0.85rem; font-weight: 600; color: var(--text-main);"><%= svc.name %></td>
                <td style="padding: 0.85rem; color: var(--gold-primary); font-weight: 500;">R$ <%= svc.price.toFixed(2).replace('.', ',') %></td>
                <td style="padding: 0.85rem; color: var(--text-muted);"><%= svc.duration_min %> minutos</td>
                <td style="padding: 0.85rem; text-align: right;">
                  <form action="/services/<%= svc.id %>/delete" method="POST" onsubmit="return confirm('Excluir este serviço impedirá novos agendamentos online dele. Confirmar exclusão?');" style="display: inline-block;">
                    <button type="submit" class="btn btn-danger btn-sm btn-icon-only" title="Excluir Serviço">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Right Side: Shop Configuration settings -->
  <div class="card card-premium" style="flex: 1 1 40%;">
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-sliders"></i> Horário & Agendamento</h3>
    </div>

    <!-- Copiar Link Público -->
    <div style="background: var(--bg-tertiary); padding: 1.25rem; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 2rem;">
      <h4 style="margin-bottom: 0.5rem; color: var(--gold-primary); font-family: 'Cinzel';"><i class="fa-solid fa-globe"></i> Página de Agendamentos</h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Use este link nas redes sociais (Instagram/WhatsApp) para os clientes marcarem direto:</p>
      
      <div class="booking-link-input-group" style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" id="servicesBookingUrlInput" class="form-control" value="<%= bookingUrl %>" readonly style="background: var(--bg-primary); border-color: var(--border-color); color: var(--gold-primary); font-weight: 500; font-size: 0.85rem;">
        <button type="button" class="btn btn-primary btn-sm" id="copyServicesBookingUrlBtn" style="white-space: nowrap; padding: 0.65rem 1rem;">
          <i class="fa-solid fa-copy"></i> Copiar
        </button>
      </div>
    </div>

    <!-- Config Form -->
    <form action="/services/config" method="POST">
      <!-- Shop Name -->
      <div class="form-group">
        <label for="shop_name" class="form-label">Nome da Barbearia *</label>
        <input type="text" id="shop_name" name="shop_name" class="form-control" value="<%= config.shop_name %>" required autocomplete="off">
      </div>

      <!-- Start and End Time -->
      <div class="service-config-times" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="open_time" class="form-label">Abertura *</label>
          <input type="time" id="open_time" name="open_time" class="form-control" value="<%= config.open_time %>" required>
        </div>
        <div class="form-group">
          <label for="close_time" class="form-label">Fechamento *</label>
          <input type="time" id="close_time" name="close_time" class="form-control" value="<%= config.close_time %>" required>
        </div>
      </div>

      <!-- Slot interval in minutes -->
      <div class="form-group">
        <label for="slot_interval" class="form-label">Intervalo de Atendimento *</label>
        <select id="slot_interval" name="slot_interval" class="form-control" required>
          <option value="15" <%= config.slot_interval === 15 ? 'selected' : '' %>>15 minutos</option>
          <option value="30" <%= config.slot_interval === 30 ? 'selected' : '' %>>30 minutos (Padrão)</option>
          <option value="45" <%= config.slot_interval === 45 ? 'selected' : '' %>>45 minutos</option>
          <option value="60" <%= config.slot_interval === 60 ? 'selected' : '' %>>1 hora</option>
        </select>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.3;">
          Define a duração e espaçamento entre cada horário disponível na página de agendamentos.
        </p>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem;">
        <i class="fa-solid fa-floppy-disk"></i> Salvar Configurações
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const servicesCopyBtn = document.getElementById('copyServicesBookingUrlBtn');
    const servicesInput = document.getElementById('servicesBookingUrlInput');

    if (servicesCopyBtn && servicesInput) {
      servicesCopyBtn.addEventListener('click', () => {
        servicesInput.select();
        servicesInput.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(servicesInput.value)
          .then(() => {
            const originalHTML = servicesCopyBtn.innerHTML;
            servicesCopyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copiado!';
            servicesCopyBtn.style.backgroundColor = 'var(--color-finalizado)';
            servicesCopyBtn.style.color = 'var(--text-dark)';
            setTimeout(() => {
              servicesCopyBtn.innerHTML = originalHTML;
              servicesCopyBtn.style.backgroundColor = '';
              servicesCopyBtn.style.color = '';
            }, 2000);
          })
          .catch(err => {
            console.error('Failed to copy text: ', err);
          });
      });
    }
  });
</script>

<%- include('../partials/footer') %>
