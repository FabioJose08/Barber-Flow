<!-- Finalize/Conclude Appointment Modal -->
<div id="finalizeModal" class="modal-overlay" style="display: none;">
  <div class="modal-card animate-fade-in">
    <div class="modal-header">
      <h3><i class="fa-solid fa-coins" style="color: var(--color-finalizado);"></i> Concluir Atendimento</h3>
      <button type="button" class="modal-close-btn" id="closeFinalizeModal">&times;</button>
    </div>
    <form id="finalizeForm" method="POST" action="">
      <div class="modal-body">
        <p class="modal-description">
          Confirme ou altere os detalhes do serviço prestado para o cliente <strong id="modalCustomerName"></strong> para registrar automaticamente no financeiro.
        </p>
        
        <!-- Service Type Selection -->
        <div class="form-group">
          <label for="modalServiceSelect" class="form-label">Serviço Realizado</label>
          <select id="modalServiceSelect" class="form-control" style="margin-bottom: 0.75rem;">
            <% if (locals.services && services.length > 0) { %>
              <% services.forEach(svc => { %>
                <option value="<%= svc.name %>" data-price="<%= svc.price %>"><%= svc.name %> (R$ <%= svc.price.toFixed(2).replace('.', ',') %>)</option>
              <% }) %>
            <% } %>
            <option value="custom" selected>Outro serviço...</option>
          </select>
          <input type="text" id="modalServiceType" name="service_type" class="form-control" placeholder="Digite o nome do serviço" required>
        </div>

        <!-- Price Input -->
        <div class="form-group">
          <label for="modalPrice" class="form-label">Valor Final Cobrado *</label>
          <div class="input-prefix-wrapper">
            <span class="input-prefix">R$</span>
            <input type="number" id="modalPrice" name="price" class="form-control" placeholder="0,00" step="0.01" min="0" required>
          </div>
        </div>

        <!-- Optional Notes -->
        <div class="form-group">
          <label for="modalNotes" class="form-label">Observações / Forma de Pagamento (Opcional)</label>
          <input type="text" id="modalNotes" name="notes" class="form-control" placeholder="Ex: Pago via Pix, Cartão, Dinheiro">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="cancelFinalizeModal">Cancelar</button>
        <button type="submit" class="btn btn-primary" style="background-color: var(--color-finalizado); border-color: var(--color-finalizado); color: var(--text-dark);">
          <i class="fa-solid fa-circle-check"></i> Confirmar e Lançar
        </button>
      </div>
    </form>
  </div>
</div>
