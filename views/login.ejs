<%- include('partials/header') %>

<div class="auth-container">
  <div class="card card-premium auth-card">
    <div class="auth-logo">
      <i class="fa-solid fa-scissors" style="font-size: 3rem; color: var(--gold-primary);"></i>
      <h2>Barber<span>Flow</span></h2>
      <p>Gestão Inteligente para sua Barbearia</p>
    </div>

    <% if (locals.error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" style="width: 100%;">
      <div class="form-group">
        <label class="form-label" for="email">
          <i class="fa-solid fa-envelope" style="margin-right: 0.4rem;"></i>E-mail
        </label>
        <input type="email" class="form-control" id="email" name="email" placeholder="seu@email.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">
          <i class="fa-solid fa-lock" style="margin-right: 0.4rem;"></i>Senha
        </label>
        <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.9rem;">
        <i class="fa-solid fa-right-to-bracket"></i> Entrar
      </button>
    </form>

    <div class="auth-footer">
      <a href="/register" style="font-size: 0.9rem;">Não tem conta? Cadastre sua barbearia</a>
      <br>
      <a href="/client/login" style="display: inline-block; margin-top: 0.75rem; font-size: 0.8rem; color: var(--gold-primary);">Área do Cliente</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
